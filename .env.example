# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL and pgvector for RAG evidence.
# This is separate from the inherited FACEGUARD_DATABASE_URL MongoDB setting.
# Docker Compose publishes PostgreSQL on 55432 because the separate PDPA
# project already uses the default local port 5432.
RAG_POSTGRES_DB=faceguard_evidence
RAG_POSTGRES_USER=faceguard
RAG_POSTGRES_PASSWORD=
RAG_POSTGRES_PORT=55432
RAG_API_PORT=8002
RAG_API_URL=http://127.0.0.1:8002
# Build this URL from the same local values. Never commit a real password.
RAG_DATABASE_URL=postgresql://faceguard:REPLACE_ME@127.0.0.1:55432/faceguard_evidence

# FaceGuard detector
# Keep the checkpoint outside this repository.
FACEGUARD_MODEL_NAME=vit3
FACEGUARD_MODEL_PATH=
FACEGUARD_MODEL_SHA256=6FAE9B18A7A7BAFED65FE5A944FC1B66A8CE070896A8531C6C5857477806C25B

# Optional inherited authentication and persistence.
# Keep false when running only the detector/RAG APIs without user accounts.
FACEGUARD_ENABLE_DATABASE=false
FACEGUARD_DATABASE_URL=mongodb://localhost:27017/faceguard
FACEGUARD_DATABASE_NAME=faceguard
FACEGUARD_UPLOAD_COLLECTION=uploads
FACEGUARD_USERS_COLLECTION=users
FACEGUARD_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Deliberately unset until an independently measured threshold is selected.
FACEGUARD_FAKE_THRESHOLD=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_REGION=Japan East
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_CHAT_MODEL=gpt-4.1-mini
AZURE_OPENAI_CHAT_MODEL_VERSION=2025-04-14
AZURE_OPENAI_CHAT_VERSION_UPGRADE_POLICY=OnceCurrentVersionExpired
AZURE_OPENAI_CHAT_MAX_OUTPUT_TOKENS=512
AZURE_OPENAI_CHAT_INPUT_PRICE_PER_MILLION_TOKENS=
AZURE_OPENAI_CHAT_CACHED_INPUT_PRICE_PER_MILLION_TOKENS=
AZURE_OPENAI_CHAT_OUTPUT_PRICE_PER_MILLION_TOKENS=
AZURE_OPENAI_CHAT_PRICING_CURRENCY=
AZURE_OPENAI_CHAT_PRICING_CHECKED_AT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=faceguard-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL_VERSION=1
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_EMBEDDING_VERSION_UPGRADE_POLICY=OnceNewDefaultVersionAvailable
# Record the official Azure price and currency on the date it is checked.
AZURE_OPENAI_EMBEDDING_PRICE_PER_MILLION_TOKENS=
AZURE_OPENAI_PRICING_CURRENCY=
AZURE_OPENAI_PRICING_CHECKED_AT=

# Local cross-encoder reranking
RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=16
