# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL and pgvector for RAG evidence.
# This is separate from the inherited FACEGUARD_DATABASE_URL MongoDB setting.
# Docker Compose publishes PostgreSQL on 55432 because the separate PDPA
# project already uses the default local port 5432.
RAG_POSTGRES_DB=faceguard_evidence
RAG_POSTGRES_USER=faceguard
RAG_POSTGRES_PASSWORD=
RAG_POSTGRES_PORT=55432
# Build this URL from the same local values. Never commit a real password.
RAG_DATABASE_URL=postgresql://faceguard:REPLACE_ME@127.0.0.1:55432/faceguard_evidence

# FaceGuard detector
# Keep the checkpoint outside this repository.
FACEGUARD_MODEL_NAME=vit3
FACEGUARD_MODEL_PATH=
FACEGUARD_MODEL_SHA256=6FAE9B18A7A7BAFED65FE5A944FC1B66A8CE070896A8531C6C5857477806C25B

# Deliberately unset until an independently measured threshold is selected.
FACEGUARD_FAKE_THRESHOLD=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
